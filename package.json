{
    "name": "collaborative-code-interviews",
    "version": "1.0.0",
    "description": "Real-time collaborative coding interview platform",
    "main": "index.js",
    "scripts": {
        "dev": "concurrently -n \"backend,frontend\" -c \"blue,green\" \"npm run dev:backend\" \"npm run dev:frontend\"",
        "dev:backend": "cd backend && make dev",
        "dev:frontend": "cd frontend && npm run dev",
        "test": "npm run test:backend && npm run test:frontend",
        "test:backend": "cd backend && make test",
        "test:frontend": "cd frontend && npm test",
        "seed": "cd backend && make seed"
    },
    "keywords": [
        "interview",
        "coding",
        "collaboration",
        "real-time"
    ],
    "author": "",
    "license": "MIT",
    "devDependencies": {
        "concurrently": "^9.1.2"
    }
}